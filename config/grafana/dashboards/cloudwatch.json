{
  "uid": "aws-cloudwatch",
  "title": "CloudWatch via aws-metrics-exporter",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "tags": [
    "cloudwatch"
  ],
  "templating": {
    "list": [
      {
        "name": "metric",
        "label": "Metric",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({source=\"aws-cloudwatch\"}, __name__)",
          "refId": "vmetric",
          "qryType": 1
        },
        "definition": "label_values({source=\"aws-cloudwatch\"}, __name__)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "account",
        "label": "Account",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({source=\"aws-cloudwatch\"}, account_id)",
          "refId": "vaccount",
          "qryType": 1
        },
        "definition": "label_values({source=\"aws-cloudwatch\"}, account_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      },
      {
        "name": "statistic",
        "label": "Statistic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({source=\"aws-cloudwatch\"}, statistic)",
          "refId": "vstatistic",
          "qryType": 1
        },
        "definition": "label_values({source=\"aws-cloudwatch\"}, statistic)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Configured metrics (config/prometheus.yml)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "AWS/EC2 CPUUtilization (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(aws_ec2_cpuutilization{account_id=~\"$account\", statistic=~\"$statistic\"}[10m])",
          "legendFormat": "{{account_id}} {{statistic}} {{InstanceId}}"
        }
      ],
      "interval": "5m",
      "description": "Latest CloudWatch datapoint; EC2 basic monitoring publishes one per 5 min, so the newest point is ~5-10 min behind real time. Timestamps match the AWS console (UTC there, browser zone here)."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "AWS/EC2 NetworkIn (bytes per 5 min, Sum)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(aws_ec2_networkin{account_id=~\"$account\", statistic=~\"$statistic\"}[10m])",
          "legendFormat": "{{account_id}} {{statistic}} {{InstanceId}}"
        }
      ],
      "interval": "5m",
      "description": "Bytes received per 5-minute period (Sum). Requires the aws-ec2-network job (statistic Sum)."
    },
    {
      "id": 4,
      "type": "row",
      "title": "Explorer (pick any metric)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "$metric",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time({source=\"aws-cloudwatch\", __name__=\"$metric\", account_id=~\"$account\", statistic=~\"$statistic\"}[10m])",
          "legendFormat": "{{account_id}} {{statistic}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Latest values",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "last_over_time({source=\"aws-cloudwatch\", __name__=\"$metric\", account_id=~\"$account\", statistic=~\"$statistic\"}[10m])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "monitor": true,
              "source": true
            }
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Scrape up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{source=\"aws-cloudwatch\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Scrape duration (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "scrape_duration_seconds{source=\"aws-cloudwatch\"}",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}