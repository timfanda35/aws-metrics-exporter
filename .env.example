# Copy to .env and adjust: cp .env.example .env
# docker-compose.yaml loads .env into the exporter service.

# --- Server ---
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json
SCRAPE_TIMEOUT=30s
MAX_CONCURRENT_SCRAPES=16
MAX_SERIES_PER_REQUEST=10000
SHUTDOWN_GRACE=10s

# --- AWS credentials (IAM user access key) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Private endpoints (exporter runs outside the VPC) ---
# Only the CloudWatch endpoint is needed: OAM cross-account reads are
# GetMetricData with AccountId, served by the same endpoint. A single fixed
# URL, so this suits single-region use.
AWS_ENDPOINT_URL_CLOUDWATCH=https://vpce-xxxx.monitoring.us-east-1.vpce.amazonaws.com
# Leave empty/remove to use the public CloudWatch endpoint.
# Only if using ?role_arn= / DEFAULT_ROLE_ARN (per-request AssumeRole):
# AWS_ENDPOINT_URL_STS=https://vpce-xxxx.sts.us-east-1.vpce.amazonaws.com
# Do NOT set the global AWS_ENDPOINT_URL: it would redirect every service.

# --- Production (Cloud Run + WIF) ---
# Omit the AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY above and set instead
# (note: AWS_ENDPOINT_URL_* are ignored on the WIF path):
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/CloudRunCloudWatchReader
# AWS_WEB_IDENTITY_TOKEN_AUDIENCE=sts.amazonaws.com
# Fallback when ?role_arn= is omitted:
# DEFAULT_ROLE_ARN=
# ROLE_SESSION_NAME=aws-metrics-exporter
# Keep CloudWatch's original timestamps (don't combine with ?time_offset=):
# PRESERVE_CW_TIMESTAMP=false
