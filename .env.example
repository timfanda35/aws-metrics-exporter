# Copy to .env and adjust: cp .env.example .env
# docker-compose.yaml loads .env into the exporter service.

# --- Server ---
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json
SCRAPE_TIMEOUT=30s
MAX_CONCURRENT_SCRAPES=16
MAX_SERIES_PER_REQUEST=10000
SHUTDOWN_GRACE=10s

# --- Local development with LocalStack ---
# Point the SDK at the local endpoint and use the LocalStack test credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL_CLOUDWATCH=http://localstack:4566

# --- Production (Cloud Run + WIF) ---
# Omit the AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_ENDPOINT_URL_CLOUDWATCH
# above and set instead:
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/CloudRunCloudWatchReader
# AWS_WEB_IDENTITY_TOKEN_AUDIENCE=sts.amazonaws.com
# Fallback when ?role_arn= is omitted:
# DEFAULT_ROLE_ARN=
# ROLE_SESSION_NAME=aws-metrics-exporter
# Keep CloudWatch's original timestamps (don't combine with ?time_offset=):
# PRESERVE_CW_TIMESTAMP=false
