# Copy to .env and adjust: cp .env.example .env
# docker-compose.yaml loads .env into the exporter service.

# --- Server ---
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=json
SCRAPE_TIMEOUT=30s
MAX_CONCURRENT_SCRAPES=16
MAX_SERIES_PER_REQUEST=10000
SHUTDOWN_GRACE=10s
# Store each sample at CloudWatch's own datapoint time so Prometheus matches the
# AWS console. The exporter emits only the newest datapoint, so timestamps never
# go backwards; rarely, CloudWatch revising a bucket's value makes Prometheus
# reject the duplicate timestamp. Set false to let Prometheus stamp scrape time.
PRESERVE_CW_TIMESTAMP=true

# --- AWS credentials (IAM user access key) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Private endpoints (exporter runs outside the VPC) ---
# VPCE hostnames differ per region, so set one variable per region. The suffix is
# the region upper-cased with '-' -> '_'. Regions without an entry use the
# fallback below, then the public endpoint.
# Only CloudWatch is needed: OAM cross-account reads are GetMetricData with
# AccountId, served by the same endpoint.
AWS_ENDPOINT_URL_CLOUDWATCH_US_EAST_1=https://vpce-xxxx.monitoring.us-east-1.vpce.amazonaws.com
AWS_ENDPOINT_URL_CLOUDWATCH_US_WEST_2=https://vpce-yyyy.monitoring.us-west-2.vpce.amazonaws.com
# Only if using ?role_arn= / DEFAULT_ROLE_ARN (per-request AssumeRole), same pattern:
# AWS_ENDPOINT_URL_STS_US_EAST_1=https://vpce-xxxx.sts.us-east-1.vpce.amazonaws.com
# Single URL for every region (SDK standard variables), used when no per-region entry matches:
# AWS_ENDPOINT_URL_CLOUDWATCH=
# AWS_ENDPOINT_URL_STS=
# Do NOT set the global AWS_ENDPOINT_URL: it would redirect every service.

# --- Debugging (local only) ---
# /debug page: run a query in the browser and see the CloudWatch calls it makes.
# It queries AWS with the exporter's credentials; never enable on a public port.
DEBUG_PAGE_ENABLED=true
# LOG_LEVEL=debug also logs every GetMetricData / ListMetrics call sent to AWS.

# --- Production (Cloud Run + WIF) ---
# Omit the AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY above and set instead
# (per-region AWS_ENDPOINT_URL_*_<REGION> also apply on this path):
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/CloudRunCloudWatchReader
# AWS_WEB_IDENTITY_TOKEN_AUDIENCE=sts.amazonaws.com
# Fallback when ?role_arn= is omitted:
# DEFAULT_ROLE_ARN=
# ROLE_SESSION_NAME=aws-metrics-exporter
